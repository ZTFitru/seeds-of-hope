# Server Configuration
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (for CORS).
# For local frontend + live backend testing, add: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email Configuration (Nodemailer)
# For Gmail, you can use:
# SMTP_SERVICE=gmail
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false

# For other SMTP servers:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Addresses
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Seeds of Hope
TO_EMAIL=your-email@gmail.com

# Options
SEND_USER_CONFIRMATION=true

# User auth (JWT) – set a long random string in production
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
APP_NAME=Seeds of Hope

# Database Configuration (MySQL – live or local)
# For local backend → live DB: use live host below and add your PUBLIC IP to the DB server’s allowed hosts.
# Find your public IP: https://whatismyip.com or run: curl -s https://api.ipify.org
DB_HOST=amelia.ducimus.digital
DB_PORT=3306
DB_NAME=seedsofhope_main
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Optional: auto-sync schema on server start (keep false when using live DB to avoid altering tables)
# DB_AUTO_SYNC=false

# Future: Payment Configuration (for when you add payment processing)
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret
